{
	"schemaVersion": 1,
	"id": "bopomofo-converter",
	"version": "${version}",
	"name": "Bopomofo Converter",
	"description": "From the Minecraft universe comes a savior — the Bopomofo Converter! A super-smart mod dedicated to saving those brain-fart moments when you forgot to switch your input method!",
	"authors": [
		"flandretw"
	],
	"contact": {
		"homepage": "https://github.com/flandretw",
		"sources": "https://github.com/flandretw/BopomofoConverter",
		"issues": "https://github.com/flandretw/BopomofoConverter/issues"
	},
	"license": "MIT",
	"icon": "assets/bopomofo-converter/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"flandretw.bopomofo.converter.BopomofoConverterMod"
		],
		"client": [
			"flandretw.bopomofo.converter.BopomofoConverterClient"
		],
		"modmenu": [
			"flandretw.bopomofo.converter.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"bopomofo-converter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft}",
		"java": ">=${java}"
	}
}